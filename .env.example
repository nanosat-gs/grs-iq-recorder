# GRS IQ Recorder — o que ESTE repositório precisa para subir isolado.
# Em produção quem manda é o .env do orquestrador (nanosat-gs/grs-station).

# Qual enlace gravar. O nome tem de existir em domain/profiles.py; se não
# existir, o serviço NÃO sobe — e a mensagem lista os perfis conhecidos.
# Derrubar o boot é deliberado: um erro de digitação aqui, se fosse tolerado,
# gravaria a campanha inteira na configuração de outro enlace.
RECORDER_PROFILE=grs-rx-fs2

# De onde o tap escuta o IQ. É o PUB que a impl. C do grs-iq-rx BINDA em
# :5556 — o gravador CONECTA nele, como qualquer outro assinante. Fora do
# Docker, troque o nome do serviço por localhost.
RECORDER_IQ_SOURCE_ADDRESS=tcp://grs-iq-rx:5556

# Onde o replay republica. Repare que é BIND (tcp://*), e não connect: no
# replay o gravador ocupa o lugar do grs-iq-rx, que precisa estar DESLIGADO —
# os dois disputariam a mesma porta. É essa simetria que faz o demodulador e
# o detector de syncword não distinguirem replay de passagem ao vivo.
RECORDER_IQ_PUBLISH_ADDRESS=tcp://*:5556

# Onde as capturas caem. No compose é um volume nomeado: a 240 kS/s são
# 1,9 MB/s, ~115 MB por minuto. Olhe o disco antes de uma campanha.
RECORDER_CAPTURE_DIR=/app/captures

# Teto de uma gravação, em segundos. Existe para que ninguém encha o disco
# sem perceber: a gravação disparada por passagem (AOS/LOS) está FORA desta
# fatia, então por enquanto toda captura é sob comando e com limite.
RECORDER_MAX_CAPTURE_SECONDS=60

# Índice de capturas (C4). SEM esta variável o serviço grava do mesmo jeito,
# só não indexa — a captura é o artefato, o índice é conveniência. Mesmo
# argumento do painel do GRS Manager, que degrada sem o TC Scheduler em vez
# de falhar.
PG_DATABASE_URL=postgresql+psycopg2://admin:admin@localhost:5432/tc_generator
